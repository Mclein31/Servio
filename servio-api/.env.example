# =============================================================================
# SERVIO API — local secrets template
#
#   1. Copy this file:   cp .env.example .env      (inside servio-api/)
#   2. Fill in the values below.
#   3. Never commit .env — it is git-ignored. Only this template is committed.
#
# Who reads servio-api/.env:
#   - `npm run dev`         (wrangler loads it into the Worker)
#   - `npm run db:migrate`  (drizzle-kit) and `npm run db:seed`
#   - `npm test`            (TEST_LOCAL_DATABASE_URL enables the database-backed tests)
#
# Production: store each secret in Cloudflare instead of this file:
#   npx wrangler secret put DATABASE_URL --env production
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
# Local development (Homebrew Postgres on this Mac):
#   DATABASE_URL="postgresql://<your-mac-username>@localhost:5432/servio_dev"
#
# Neon (when ready): console.neon.tech → project → "Connect".
#   DATABASE_URL           → the POOLED string (host contains "-pooler"), for request traffic.
#   DATABASE_URL_UNPOOLED  → the direct string (pooling OFF), for migrations.
#   Both end with ?sslmode=require
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Throwaway local database for the database-backed tests. Must point at localhost:
# the tests create and delete rows freely.
TEST_LOCAL_DATABASE_URL=""


# -----------------------------------------------------------------------------
# CLOUDFLARE R2 (add-on evidence photos, request photos, Pro KYC documents)
# -----------------------------------------------------------------------------
# dash.cloudflare.com → R2 Object Storage:
#   - Create buckets "servio-uploads-dev" and "servio-uploads".
#   - "Manage API tokens" → "Create API token" → Object Read & Write, scoped to both buckets.
#   - Copy "Access Key ID" and "Secret Access Key" (shown once).
# Local Wi-Fi demo: UPLOADS_MODE=local uses Wrangler simulated R2; no cloud account
# is needed. PIN_SECRET signs upload/download capability URLs. Production forbids local.
# Account ID: right-hand "Account Details" panel, or the 32-char id in the dashboard URL.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""


# -----------------------------------------------------------------------------
# EMAIL (app sign-in codes) — Gmail for now, instead of paid SMS
# -----------------------------------------------------------------------------
# Leave SMTP_USER / SMTP_PASSWORD empty in local development: the code is printed in the
# API log ("devMail") instead of emailed. Production refuses to send without them.
#
# Gmail: turn on 2-Step Verification (myaccount.google.com → Security), then create an
# App Password at myaccount.google.com/apppasswords named "SERVIO API" and paste it below.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
MAIL_FROM_NAME="SERVIO"


# -----------------------------------------------------------------------------
# ESCROW
# -----------------------------------------------------------------------------
# 32 random bytes, base64. Derives each booking's 4-digit completion PIN (HMAC), so PINs are
# never stored. Generate once per environment:  openssl rand -base64 32
PIN_SECRET=""

# Fixed booking trust fee in integer centavos; prototype assumption to validate before launch.
# Set the same value as a Worker variable per environment. No external credentials needed.
TRUST_FEE_CENTAVOS="5000"

# City profile key in src/config/cities.ts (also set in wrangler.toml).
# Add a verified profile there before selecting another city. No credentials needed.
LAUNCH_CITY="tuguegarao"

# local = local Wrangler R2 binding for dev/demo; r2 = SERVIO cloud bucket + R2_* keys.
# Set r2 after creating the dedicated buckets above; never use local in production.
UPLOADS_MODE="local"
