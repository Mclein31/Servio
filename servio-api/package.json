{
  "name": "servio-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit && wrangler deploy --dry-run --env=\"\" --outdir dist",
    "deploy": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "db:demo-reset": "tsx scripts/demo-tools.ts reset",
    "db:backup": "tsx scripts/demo-tools.ts backup",
    "db:restore": "tsx scripts/demo-tools.ts restore"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@hono/valibot-validator": "^0.6.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
