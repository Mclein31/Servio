{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "servio-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "servio-app",
        "start",
        "--",
        "--port",
        "8100"
      ],
      "port": 8100
    },
    {
      "name": "servio-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "servio-api",
        "run",
        "dev"
      ],
      "port": 8787,
      "url": "http://localhost:8787"
    }
  ]
}